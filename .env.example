# Preflight Environment Configuration

# Your SerpApi API Key (get one free at https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Cache settings (default: true)
PREFLIGHT_CACHE_ENABLED=true
PREFLIGHT_CACHE_DIR=.preflight_cache

# Optional: Default ecosystem (python, javascript, typescript, rust, go, general)
PREFLIGHT_DEFAULT_ECOSYSTEM=general

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
PREFLIGHT_LOG_LEVEL=INFO

